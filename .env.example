# TimescaleDB (PostgreSQL) Database Configuration
# Default setup script uses password 'kimp_password'
# DATABASE_URL=postgresql://kimp_user:kimp_password@localhost:5432/kimp_station
DATABASE_URL=postgresql://kimp_user:kimp_password@localhost:5432/kimp_station

# Korea Investment (KIS) API Credentials
KINVEST_API_KEY=your_api_key_here
KINVEST_SECRET_KEY=your_secret_key_here

# Commodity Futures Code (Default: A75601 for USD Futures)
KINVEST_FUTURES_CODE=A75601

# Upbit Markets (comma-separated)
UPBIT_SYMBOLS=KRW-USDT,KRW-BTC,KRW-ETH,KRW-XRP,BTC-USDT,USDT-BTC

# Binance Spot Markets (comma-separated)
BINANCE_SYMBOLS=BTCUSDT,ETHUSDT,XRPUSDT
