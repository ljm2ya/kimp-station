          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  time_bucket('$interval', time) AS time,\n  source || ' ' || symbol AS metric,\n  AVG(\n    ((data->'asks'->0->>'price')::numeric - (data->'bids'->0->>'price')::numeric) \n    / (data->'bids'->0->>'price')::numeric * 100\n  ) AS value\nFROM snapshots\nWHERE $__timeFilter(time)\n  AND (data->'bids'->0->>'price')::numeric > 0\nGROUP BY 1, source, symbol\nORDER BY 1",
          "refId": "A"
        }
      ],
      "title": "Orderbook Spread (%)",
      "type": "timeseries"
